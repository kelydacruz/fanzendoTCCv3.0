<%- include('../partials/header') %>
<section class="topo-pagina"><div class="container"><span class="destaque">Moderação</span><h1>Denúncias</h1><p>Analise o conteúdo denunciado e registre o resultado. A denúncia não bloqueia automaticamente o autor.</p></div></section>
<section class="secao container"><%- include('_nav') %>
<form action="/admin/denuncias" method="get" class="filtros bloco">
<div class="campo campo-busca"><label for="busca-denuncia">Pesquisar denúncias</label><input type="search" id="busca-denuncia" name="q" maxlength="150" value="<%= busca %>" placeholder="Autor, mensagem, motivo ou situação"></div>
<button type="submit" class="btn btn-primario">Pesquisar</button><a href="/admin/denuncias" class="btn btn-secundario">Limpar</a>
</form>
<p role="status"><%= denuncias.length %> denúncia(s) encontrada(s).</p>
<div class="lista-admin">
<% denuncias.forEach((item) => { %>
<article class="bloco">
    <span class="status"><%= item.status === 'pendente' ? 'Pendente' : 'Analisada' %></span>
    <h2><%= item.tipo === 'usuario' ? 'Usuário:' : item.tipo === 'comentario' ? 'Comentário de' : 'Mensagem de' %> <%= item.nomeAutor %></h2><blockquote><%= item.texto %></blockquote>
    <p><strong>Motivo:</strong> <%= item.motivo %></p><small><%= formatarData(item.createdAt) %></small>
    <% if (item.status === 'pendente') { %>
    <form action="/admin/denuncias/<%= idTexto(item) %>/analisar" method="post" class="formulario">
        <label for="resposta-<%= idTexto(item) %>">Resultado da análise (enviado a quem denunciou)</label>
        <textarea id="resposta-<%= idTexto(item) %>" name="resposta" rows="3" minlength="5" maxlength="250" required></textarea>
        <div class="botoes-linha"><button class="btn btn-primario" type="submit">Concluir análise</button><a class="btn btn-secundario" href="/admin/usuarios">Gerenciar usuários</a></div>
    </form>
    <% } else { %><p><strong>Resposta:</strong> <%= item.resposta %></p><% } %>
<a class="btn btn-perigo btn-pequeno" href="/admin/denuncias/<%= idTexto(item) %>/excluir?q=<%= encodeURIComponent(busca) %>">Excluir denúncia</a>
</article>
<% }) %>
<% if (!denuncias.length) { %><div class="bloco estado-vazio"><h2>Nenhuma denúncia encontrada.</h2></div><% } %>
</div></section>
<%- include('../partials/footer') %>
