<%- include('../partials/header') %>

<section class="topo-pagina"><div class="container"><span class="destaque">Administração</span><h1>Áreas de atuação</h1><p>Essas opções aparecem no cadastro e no perfil dos professores e nas ideias.</p></div></section>

<section class="secao container">
    <%- include('_nav') %>
    <div class="admin-duas-colunas">
        <form class="formulario bloco" action="/admin/areas<%= edicao ? `/${edicao}/editar` : '' %>" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <h2><%= edicao ? 'Editar área' : 'Nova área' %></h2>
            <% if (erro) { %><div class="erro-form" role="alert"><%= erro %></div><% } %>
            <label for="nome">Nome da área *</label>
            <input id="nome" name="nome" value="<%= dados.nome || '' %>" maxlength="100" required placeholder="Desenvolvimento de Sistemas">
            <button class="btn btn-primario" type="submit"><%= edicao ? 'Salvar alterações' : 'Cadastrar área' %></button>
            <% if (edicao) { %>
                <a class="btn btn-secundario" href="/admin/areas">Cancelar edição</a>
                <p class="texto-suave">Os nomes já registrados em trabalhos e perfis serão preservados como histórico.</p>
            <% } %>
        </form>

        <div class="lista-admin">
            <% areas.forEach((area) => { %>
                <article class="bloco item-admin">
                    <div><span class="etiqueta"><%= area.ativo ? 'Ativa' : 'Inativa' %></span><h2><%= area.nome %></h2></div>
                    <div class="botoes-linha">
                        <a class="btn btn-secundario btn-pequeno" href="/admin/areas/<%= idTexto(area) %>/editar">Editar</a>
                        <form action="/admin/areas/<%= idTexto(area) %>/status" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ativo" value="<%= area.ativo ? 'false' : 'true' %>"><button class="btn btn-secundario btn-pequeno" type="submit"><%= area.ativo ? 'Desativar' : 'Reativar' %></button></form>
                    <a class="btn btn-perigo btn-pequeno" href="/admin/areas/<%= idTexto(area) %>/excluir">Excluir área</a>
                    </div>
                </article>
            <% }) %>
        </div>
    </div>
</section>

<%- include('../partials/footer') %>
