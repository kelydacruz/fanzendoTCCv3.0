<%- include('partials/header') %>

<section class="hero">
    <div class="container hero-grid">
        <div>
            <span class="destaque destaque-com-linha">Conhecimento que continua</span>
            <h1>Encontre referências para construir um TCC melhor.</h1>
            <p>
                Pesquise trabalhos concluídos, descubra ideias de projetos e compartilhe conhecimento com a comunidade acadêmica.
            </p>
            <form class="busca-principal" action="/tcc/lst" method="get">
                <label class="sr-only" for="busca-home">Pesquisar TCC</label>
                <input id="busca-home" type="search" name="q" placeholder="Digite um tema, título ou palavra-chave">
                <button class="btn btn-primario" type="submit">Pesquisar</button>
            </form>
            <div class="hero-acoes">
                <a class="btn btn-secundario" href="/ideia/lst">Explorar ideias</a>
                <% if (usuario?.perfil === 'aluno') { %>
                    <a class="link-seta" href="/tcc/add">Publicar meu TCC →</a>
                <% } %>
            </div>
        </div>

        <aside class="hero-painel" aria-label="Resumo da plataforma">
            <div class="hero-painel-topo">
                <span>Acervo acadêmico</span>
                <span class="indicador-ativo">Disponível</span>
            </div>
            <div class="documento-destaque">
                <span class="documento-miniatura" aria-hidden="true">TCC</span>
                <div>
                    <strong>Pesquisa organizada e acessível</strong>
                    <p>Trabalhos, ideias e orientações reunidos em uma única plataforma.</p>
                </div>
            </div>
            <dl class="hero-resumo-dados">
                <div><dt>Trabalhos</dt><dd><%= formatarNumero(totalTccs) %></dd></div>
                <div><dt>Cursos</dt><dd><%= formatarNumero(cursos.length) %></dd></div>
                <div><dt>Ideias</dt><dd><%= formatarNumero(totalIdeias) %></dd></div>
            </dl>
            <a class="hero-painel-link" href="/tcc/lst">Acessar o acervo completo <span aria-hidden="true">→</span></a>
        </aside>
    </div>
</section>

<section class="faixa-estatisticas" aria-label="Números do acervo">
    <div class="container estatisticas-grid">
        <div><span class="estatistica-rotulo">TCCs publicados</span><strong><%= formatarNumero(totalTccs) %></strong></div>
        <div><span class="estatistica-rotulo">Cursos no acervo</span><strong><%= formatarNumero(cursos.length) %></strong></div>
        <div><span class="estatistica-rotulo">Visualizações</span><strong><%= formatarNumero(totalVisualizacoes) %></strong></div>
        <div><span class="estatistica-rotulo">Ideias compartilhadas</span><strong><%= formatarNumero(totalIdeias) %></strong></div>
    </div>
</section>

<section class="secao container">
    <div class="titulo-secao">
        <div>
            <span class="destaque">Explore por curso</span>
            <h2>Encontre referências da sua área</h2>
            <p>Escolha um curso para ver trabalhos publicados por outros estudantes.</p>
        </div>
    </div>
    <div class="cursos-grid">
        <% cursos.forEach((curso, indice) => { %>
            <a class="curso-card" href="/tcc/lst?curso=<%= encodeURIComponent(curso.nome) %>">
                <span class="curso-icone" aria-hidden="true"><%= String(indice + 1).padStart(2, '0') %></span>
                <span><strong><%= curso.nome %></strong><small><%= curso.total %> trabalho<%= curso.total === 1 ? '' : 's' %></small></span>
                <span aria-hidden="true">→</span>
            </a>
        <% }) %>
    </div>
</section>

<section class="secao container">
    <div class="titulo-secao">
        <div>
            <span class="destaque">Acervo</span>
            <h2>TCCs publicados recentemente</h2>
            <p>Use os trabalhos como referência, respeitando sempre a autoria.</p>
        </div>
        <a class="link-seta" href="/tcc/lst">Ver todos →</a>
    </div>
    <div class="grade grade-3">
        <% tccs.forEach((tcc) => { %>
            <%- include('partials/tcc-card', { tcc }) %>
        <% }) %>
    </div>
</section>

<section class="secao secao-azul">
    <div class="container">
        <div class="titulo-secao titulo-claro">
            <div>
                <span class="destaque">Biblioteca colaborativa</span>
                <h2>Ideias que ainda podem virar TCC</h2>
                <p>Alunos e professores podem sugerir problemas reais e trocar orientações.</p>
            </div>
            <a class="btn btn-claro" href="/ideia/add">Compartilhar ideia</a>
        </div>
        <div class="grade grade-3">
            <% ideias.forEach((ideia) => { %>
                <%- include('partials/ideia-card', { ideia }) %>
            <% }) %>
        </div>
    </div>
</section>

<section class="secao container">
    <div class="chamada-aprender">
        <div>
            <span class="destaque">Guia prático</span>
            <h2>Não sabe por onde começar o TCC?</h2>
            <p>Acompanhe uma trilha simples, da escolha do tema até o checklist da apresentação.</p>
        </div>
        <a class="btn btn-claro" href="/aprender">Aprenda a fazer seu TCC</a>
    </div>
</section>

<section class="secao container como-funciona">
    <span class="destaque">Como funciona</span>
    <h2>Uma plataforma simples para organizar o conhecimento da escola.</h2>
    <div class="grade grade-3 passos">
        <article><span>01</span><h3>Consulte</h3><p>Pesquise TCCs por título, tema, resumo ou palavra-chave.</p></article>
        <article><span>02</span><h3>Colabore</h3><p>Comente com dúvidas, sugestões e orientações construtivas.</p></article>
        <article><span>03</span><h3>Publique</h3><p>Registre trabalhos concluídos e novas ideias com autoria identificada.</p></article>
    </div>
</section>

<%- include('partials/footer') %>
