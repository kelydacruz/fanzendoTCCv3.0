<article class="card card-ideia">
    <div class="card-topo">
        <span class="status status-<%= classeStatus(ideia.status) %>"><%= ideia.status %></span>
        <span class="etiqueta origem-<%= ideia.origem || 'interna' %>"><%= (ideia.origem || 'interna') === 'externa' ? 'Externa' : 'Interna' %></span>
    </div>
    <div class="meta-card">
        <span class="tema"><%= ideia.tema %></span>
        <span class="dificuldade"><%= ideia.dificuldade %></span>
    </div>
    <h3><a href="/ideia/detalhes/<%= idTexto(ideia) %>"><%= ideia.titulo %></a></h3>
    <p><%= ideia.descricao %></p>
    <div class="card-rodape">
        <span><%= ideia.curso %> · <%= formatarData(ideia.createdAt) %></span>
        <a href="/ideia/detalhes/<%= idTexto(ideia) %>">Ver ideia →</a>
    </div>
</article>
