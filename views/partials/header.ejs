<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#1b7150">
    <meta name="description" content="Plataforma para publicação e consulta de TCCs e ideias">
    <title><%= title %> | AcervoTCC</title>
    <script src="/public/js/tema.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/temas.css">
    <link rel="stylesheet" href="/public/css/elementos.css">
</head>
<body class="<%= caminhoAtual.startsWith('/admin') ? 'pagina-admin' : '' %>">
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

    <header class="cabecalho">
        <div class="container navegacao">
            <a class="logo" href="/" aria-label="AcervoTCC - página inicial">
                <span class="logo-simbolo" aria-hidden="true">AT</span>
                <span class="logo-texto">
                    <span>Acervo<strong>TCC</strong></span>
                    <small>Portal acadêmico</small>
                </span>
            </a>

            <button class="menu-botao" type="button" aria-label="Abrir menu" aria-controls="menu-principal" aria-expanded="false">
                <span class="menu-icone" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>Menu</span>
            </button>

            <nav class="menu" id="menu-principal" aria-label="Navegação principal">
                <a class="<%= caminhoAtual === '/' ? 'ativo' : '' %>" href="/">Início</a>
                <a class="<%= caminhoAtual.startsWith('/tcc') ? 'ativo' : '' %>" href="/tcc/lst">TCCs</a>
                <% if (usuario) { %>
                    <a class="<%= caminhoAtual.startsWith('/ideia') ? 'ativo' : '' %>" href="/ideia/lst"><%= usuario.perfil === 'colaborador' ? 'Minhas ideias' : 'Ideias' %></a>
                    <% if (usuario.perfil !== 'colaborador') { %><a class="<%= caminhoAtual === '/aprender' ? 'ativo' : '' %>" href="/aprender">Aprender</a><% } %>
                    <% if (usuario.perfil === 'professor') { %>
                        <a class="<%= caminhoAtual.startsWith('/orientacoes') ? 'ativo' : '' %>" href="/orientacoes">Orientações</a>
                    <% } %>
                    <% if (usuario.perfil === 'admin') { %>
                        <a class="<%= caminhoAtual.startsWith('/admin') ? 'ativo' : '' %>" href="/admin">Administração</a>
                    <% } %>
                <% } %>
                <a class="<%= caminhoAtual === '/sobre' ? 'ativo' : '' %>" href="/sobre">Sobre</a>
            </nav>

            <div class="acoes-usuario">
                <button class="tema-botao" type="button" data-alternar-tema
                    aria-label="Tema escuro" aria-pressed="false" title="Ativar tema escuro" hidden>
                    <svg class="icone tema-lua" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 13.2A9 9 0 0 1 10.8 3.2 9 9 0 1 0 20.8 13.2Z"/></svg>
                    <svg class="icone tema-sol" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
                </button>
                <% if (usuario) { %>
                    <a class="link-mensagens <%= caminhoAtual.startsWith('/mensagens') ? 'ativo' : '' %>" href="/mensagens" aria-label="Mensagens" title="Mensagens" <%- caminhoAtual.startsWith('/mensagens') ? 'aria-current="page"' : '' %>>
                        <svg class="icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h3v3l5-3h8a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2Z"/><path d="M7 9h10M7 13h7"/></svg>
                    </a>
                    <a class="link-notificacoes <%= caminhoAtual.startsWith('/notificacoes') ? 'ativo' : '' %>" href="/notificacoes" aria-label="Notificações">
                        <svg class="icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/></svg><span class="sr-only">Notificações</span><% if (notificacoesNaoLidas > 0) { %><span class="badge-notificacao"><%= notificacoesNaoLidas %></span><% } %>
                    </a>
                    <a class="usuario-link" href="/perfil" aria-label="Meu perfil">
                        <span class="usuario-avatar" aria-hidden="true"><%= usuario.nome.charAt(0).toUpperCase() %></span>
                        <span><%= usuario.nome.split(' ')[0] %></span>
                    </a>
                    <form action="/sair" method="post">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-secundario btn-pequeno" type="submit">Sair</button>
                    </form>
                <% } else { %>
                    <a class="btn btn-secundario btn-pequeno" href="/entrar">Entrar</a>
                    <a class="btn btn-primario btn-pequeno" href="/cadastro">Criar conta</a>
                <% } %>
            </div>
        </div>
    </header>

    <% if (modoDemo) { %>
        <div class="aviso-demo">
            Modo demonstração ativo. Os dados serão reiniciados quando o servidor for desligado.
        </div>
    <% } %>

    <% if (mensagem) { %>
        <div class="container mensagem" role="status"><%= mensagem %></div>
    <% } %>

    <main id="conteudo">
