<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#12377a">
    <meta name="description" content="Plataforma para publicação e consulta de TCCs e ideias">
    <title><%= title %> | AcervoTCC</title>
    <link rel="stylesheet" href="/public/css/style.css">
</head>
<body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

    <header class="cabecalho">
        <div class="container navegacao">
            <a class="logo" href="<%= usuario ? '/' : '/tcc/lst' %>" aria-label="AcervoTCC - página inicial">
                <span class="logo-simbolo" aria-hidden="true">AT</span>
                <span class="logo-texto">
                    <span>Acervo<strong>TCC</strong></span>
                    <small>Portal acadêmico</small>
                </span>
            </a>

            <button class="menu-botao" type="button" aria-label="Abrir menu" aria-controls="menu-principal" aria-expanded="false">
                <span class="menu-icone" aria-hidden="true"><i></i><i></i><i></i></span>
                <span>Menu</span>
            </button>

            <nav class="menu" id="menu-principal" aria-label="Navegação principal">
                <a class="<%= caminhoAtual === '/' ? 'ativo' : '' %>" href="/">Início</a>
                <a class="<%= caminhoAtual.startsWith('/tcc') ? 'ativo' : '' %>" href="/tcc/lst">TCCs</a>
                <% if (usuario) { %>
                    <a class="<%= caminhoAtual.startsWith('/ideia') ? 'ativo' : '' %>" href="/ideia/lst">Ideias</a>
                    <a class="<%= caminhoAtual === '/aprender' ? 'ativo' : '' %>" href="/aprender">Aprender</a>
                    <a class="<%= caminhoAtual === '/sobre' ? 'ativo' : '' %>" href="/sobre">Sobre</a>
                    <% if (usuario.perfil === 'professor') { %>
                        <a class="<%= caminhoAtual.startsWith('/orientacoes') ? 'ativo' : '' %>" href="/orientacoes">Orientações</a>
                    <% } %>
                    <% if (usuario.perfil === 'admin') { %>
                        <a class="<%= caminhoAtual.startsWith('/admin') ? 'ativo' : '' %>" href="/admin">Administração</a>
                    <% } %>
                <% } %>
            </nav>

            <div class="acoes-usuario">
                <% if (usuario) { %>
                    <a class="link-notificacoes <%= caminhoAtual.startsWith('/notificacoes') ? 'ativo' : '' %>" href="/notificacoes" aria-label="Notificações">
                        Notificações<% if (notificacoesNaoLidas > 0) { %><span class="badge-notificacao"><%= notificacoesNaoLidas %></span><% } %>
                    </a>
                    <a class="usuario-link" href="/perfil">
                        <span class="usuario-avatar" aria-hidden="true"><%= usuario.nome.charAt(0).toUpperCase() %></span>
                        <span><%= usuario.nome.split(' ')[0] %></span>
                    </a>
                    <form action="/sair" method="post">
                        <button class="btn btn-secundario btn-pequeno" type="submit">Sair</button>
                    </form>
                <% } else { %>
                    <a class="btn btn-secundario btn-pequeno" href="/entrar">Entrar</a>
                    <a class="btn btn-primario btn-pequeno" href="/cadastro">Criar conta</a>
                <% } %>
            </div>
        </div>
    </header>

    <% if (modoDemo) { %>
        <div class="aviso-demo">
            Modo demonstração ativo. Os dados serão reiniciados quando o servidor for desligado.
        </div>
    <% } %>

    <% if (mensagem) { %>
        <div class="container mensagem" role="status"><%= mensagem %></div>
    <% } %>

    <main id="conteudo">
