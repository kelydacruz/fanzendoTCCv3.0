<%- include('../partials/header') %>

<section class="topo-pagina detalhes-topo">
    <div class="container">
        <a class="voltar" href="/tcc/lst">← Voltar para TCCs</a>
        <div class="detalhes-cabecalho">
            <div>
                <span class="etiqueta"><%= tcc.tema %></span>
                <h1><%= tcc.titulo %></h1>
                <p>Publicado por <strong><%= tcc.autor?.nome || 'Autor não informado' %></strong> em <%= formatarData(tcc.createdAt) %>.</p>
            </div>
            <% if (podeEditar) { %>
                <div class="botoes-linha">
                    <a class="btn btn-secundario" href="/tcc/edt/<%= idTexto(tcc) %>">Editar</a>
                    <form action="/tcc/del/<%= idTexto(tcc) %>" method="post" data-confirm="Tem certeza que deseja excluir este TCC?">
                        <button class="btn btn-perigo" type="submit">Excluir</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>
</section>

<section class="secao container detalhes-layout">
    <article class="conteudo-publicacao">
        <div class="bloco">
            <h2>Resumo</h2>
            <p class="resumo"><%= tcc.resumo %></p>
        </div>

        <div class="bloco">
            <h2>Informações do trabalho</h2>
            <dl class="lista-dados">
                <div><dt>Curso</dt><dd><%= tcc.curso %></dd></div>
                <div><dt>Ano</dt><dd><%= tcc.ano %></dd></div>
                <div><dt>Orientador</dt><dd><%= tcc.orientador %></dd></div>
                <div><dt>Autor principal</dt><dd><%= tcc.autor?.nome || 'Não informado' %></dd></div>
                <div><dt>Coautores</dt><dd><%= (tcc.coautores || []).join(', ') || 'Nenhum' %></dd></div>
                <div><dt>Tema</dt><dd><%= tcc.tema %></dd></div>
            </dl>
            <% if ((tcc.palavrasChave || []).length) { %>
                <div class="tags tags-grandes">
                    <% tcc.palavrasChave.forEach((palavra) => { %><span><%= palavra %></span><% }) %>
                </div>
            <% } %>
        </div>

        <div class="bloco comentarios">
            <h2>Comentários <span>(<%= comentarios.length %>)</span></h2>

            <% if (usuario) { %>
                <form class="comentario-form" action="/tcc/comentario/<%= idTexto(tcc) %>" method="post">
                    <label for="texto">Deixe uma dúvida, dica ou explicação</label>
                    <textarea id="texto" name="texto" rows="3" maxlength="500" required></textarea>
                    <button class="btn btn-primario" type="submit">Comentar</button>
                </form>
            <% } else { %>
                <p class="chamada-login"><a href="/entrar">Entre na sua conta</a> para participar da conversa.</p>
            <% } %>

            <div class="lista-comentarios">
                <% comentarios.forEach((comentario) => { %>
                    <article>
                        <div><strong><%= comentario.autor?.nome || 'Usuário' %></strong><span><%= comentario.autor?.perfil || '' %> · <%= formatarData(comentario.createdAt) %></span></div>
                        <p><%= comentario.texto %></p>
                    </article>
                <% }) %>
                <% if (!comentarios.length) { %><p>Ainda não há comentários. Seja a primeira pessoa a contribuir.</p><% } %>
            </div>
        </div>
    </article>

    <aside class="bloco documento-box">
        <span class="documento-icone" aria-hidden="true">PDF</span>
        <h2>Trabalho completo</h2>
        <% if (temPdf) { %>
            <p>Consulte o documento enviado pelo autor em uma nova aba.</p>
            <a class="btn btn-primario btn-largura" href="/tcc/pdf/<%= idTexto(tcc) %>" target="_blank" rel="noopener">Visualizar PDF</a>
        <% } else { %>
            <p>O autor ainda não anexou o arquivo completo a esta publicação.</p>
            <span class="btn btn-desativado btn-largura" aria-disabled="true">PDF indisponível</span>
        <% } %>
        <button class="btn btn-secundario btn-largura copiar-link" type="button">Copiar link</button>
    </aside>
</section>

<%- include('../partials/footer') %>
