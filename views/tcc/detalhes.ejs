<%- include('../partials/header') %>

<section class="topo-pagina detalhes-topo">
    <div class="container">
        <a class="voltar" href="/tcc/lst">← Voltar para TCCs</a>
        <div class="detalhes-cabecalho">
            <div>
                <span class="status status-<%= classeStatus(tcc.status || 'publicado') %>"><%= (tcc.status || 'publicado').replaceAll('_', ' ') %></span>
                <span class="etiqueta"><%= tcc.visibilidade === 'interno' ? 'Acervo interno' : 'Acervo público' %></span>
                <h1><%= tcc.titulo %></h1>
                <p><%= (tcc.status || 'publicado') === 'publicado' ? 'Publicado' : 'Enviado' %> por <strong><%= tcc.autor?.nome || 'Autor não informado' %></strong> em <%= formatarData(tcc.createdAt) %>.</p>
            </div>
            <% if (podeEditar || podeExcluir) { %>
                <div class="botoes-linha">
                    <% if (podeEditar) { %><a class="btn btn-secundario" href="/tcc/edt/<%= idTexto(tcc) %>">Editar</a><% } %>
                    <% if (podeExcluir) { %>
                        <form action="/tcc/del/<%= idTexto(tcc) %>" method="post" data-confirm="Tem certeza que deseja excluir este TCC?">
                            <button class="btn btn-perigo" type="submit">Excluir</button>
                        </form>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</section>

<section class="secao container detalhes-layout">
    <article class="conteudo-publicacao">
        <div class="bloco">
            <h2>Resumo</h2>
            <p class="resumo"><%= tcc.resumo %></p>
        </div>

        <% if (tcc.status && tcc.status !== 'publicado') { %>
            <div class="bloco acompanhamento-tcc">
                <span class="destaque">Acompanhamento</span>
                <h2><%= tcc.status === 'correcao_solicitada' ? 'O orientador solicitou correções' : (tcc.status === 'rejeitado' ? 'O trabalho precisa ser revisto' : 'O trabalho está com o orientador') %></h2>
                <p><%= tcc.feedbackOrientador || 'Ainda não há uma observação do professor orientador.' %></p>
                <% if (podeEditar) { %><a class="btn btn-primario" href="/tcc/edt/<%= idTexto(tcc) %>">Revisar e reenviar</a><% } %>
            </div>
        <% } %>

        <% if (podeAvaliar) { %>
            <form class="bloco formulario avaliacao-tcc" action="/orientacoes/<%= idTexto(tcc) %>/avaliar" method="post">
                <span class="destaque">Parecer do orientador</span>
                <h2>Avaliar trabalho</h2>
                <label for="feedbackOrientador">Correções ou observação</label>
                <textarea id="feedbackOrientador" name="feedbackOrientador" rows="5" maxlength="2000"><%= tcc.feedbackOrientador || '' %></textarea>
                <div class="botoes-linha">
                    <button class="btn btn-secundario" name="acao" value="corrigir" type="submit">Pedir correções</button>
                    <button class="btn btn-primario" name="acao" value="aprovar" type="submit">Aprovar e publicar</button>
                </div>
            </form>
        <% } %>

        <div class="bloco">
            <h2>Informações do trabalho</h2>
            <dl class="lista-dados">
                <div><dt>Curso</dt><dd><%= tcc.curso %></dd></div>
                <div><dt>Área</dt><dd><%= tcc.area %></dd></div>
                <div><dt>Turma</dt><dd><%= tcc.turma %></dd></div>
                <div><dt>Ano</dt><dd><%= tcc.ano %></dd></div>
                <div><dt>Orientador</dt><dd><%= tcc.orientadorUsuario?.nome || tcc.orientador %></dd></div>
                <div><dt>Autor principal</dt><dd><%= tcc.autor?.nome || 'Não informado' %></dd></div>
                <div><dt>Coautores</dt><dd><%= (tcc.coautores || []).join(', ') || 'Nenhum' %></dd></div>
                <div><dt>Tema</dt><dd><%= tcc.tema %></dd></div>
                <div><dt>Visibilidade</dt><dd><%= tcc.visibilidade === 'interno' ? 'Somente comunidade escolar' : 'Público' %></dd></div>
            </dl>
            <% if ((tcc.palavrasChave || []).length) { %>
                <div class="tags tags-grandes">
                    <% tcc.palavrasChave.forEach((palavra) => { %><span><%= palavra %></span><% }) %>
                </div>
            <% } %>
        </div>

        <% if (tcc.ideiaOrigem) { %>
            <div class="bloco aviso-fluxo">
                <span class="destaque">Origem do projeto</span>
                <h2>Este TCC foi desenvolvido a partir de uma ideia do portal</h2>
                <p><a href="/ideia/detalhes/<%= idTexto(tcc.ideiaOrigem) %>"><%= tcc.ideiaOrigem.titulo %></a></p>
            </div>
        <% } %>

        <div class="bloco comentarios">
            <h2>Comentários <span>(<%= comentarios.length %>)</span></h2>

            <% if (comentariosPermitidos) { %>
                <form class="comentario-form" action="/tcc/comentario/<%= idTexto(tcc) %>" method="post">
                    <label for="texto">Deixe uma dúvida, dica ou explicação</label>
                    <textarea id="texto" name="texto" rows="3" maxlength="500" required></textarea>
                    <button class="btn btn-primario" type="submit">Comentar</button>
                </form>
            <% } else { %>
                <p class="chamada-login"><a href="/entrar">Entre com um e-mail institucional</a> para participar da conversa.</p>
            <% } %>

            <div class="lista-comentarios">
                <% comentarios.forEach((comentario) => { %>
                    <article>
                        <div><strong><%= comentario.autor?.nome || 'Usuário' %></strong><span><%= comentario.autor?.perfil || '' %> · <%= formatarData(comentario.createdAt) %></span></div>
                        <p><%= comentario.texto %></p>
                    </article>
                <% }) %>
                <% if (!comentarios.length) { %><p>Ainda não há comentários. Seja a primeira pessoa a contribuir.</p><% } %>
            </div>
        </div>
    </article>

    <aside class="bloco documento-box">
        <span class="documento-icone" aria-hidden="true">PDF</span>
        <h2>Trabalho completo</h2>
        <div class="metricas-documento">
            <span><strong><%= formatarNumero(tcc.visualizacoes) %></strong> visualizações</span>
            <span><strong><%= formatarNumero(tcc.downloads) %></strong> acessos ao PDF</span>
        </div>
        <% if (temPdf) { %>
            <p>Consulte o documento enviado pelo autor em uma nova aba.</p>
            <a class="btn btn-primario btn-largura" href="/tcc/pdf/<%= idTexto(tcc) %>" target="_blank" rel="noopener">Visualizar PDF</a>
        <% } else { %>
            <p>O autor ainda não anexou o arquivo completo a esta publicação.</p>
            <span class="btn btn-desativado btn-largura" aria-disabled="true">PDF indisponível</span>
        <% } %>
        <button class="btn btn-secundario btn-largura copiar-link" type="button">Copiar link</button>
    </aside>
</section>

<% if (relacionados.length) { %>
    <section class="secao container relacionados">
        <div class="titulo-secao">
            <div>
                <span class="destaque">Continue pesquisando</span>
                <h2>TCCs relacionados</h2>
            </div>
            <a class="link-seta" href="/tcc/lst?curso=<%= encodeURIComponent(tcc.curso) %>">Ver o curso →</a>
        </div>
        <div class="grade grade-3">
            <% relacionados.forEach((relacionado) => { %>
                <%- include('../partials/tcc-card', { tcc: relacionado }) %>
            <% }) %>
        </div>
    </section>
<% } %>

<%- include('../partials/footer') %>
