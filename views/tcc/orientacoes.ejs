<%- include('../partials/header') %>

<section class="topo-pagina">
    <div class="container">
        <span class="destaque">Professor orientador</span>
        <h1>TCCs orientados</h1>
        <p>Analise os trabalhos enviados, peça correções ou aprove a publicação no acervo.</p>
    </div>
</section>

<section class="secao container">
    <nav class="botoes-linha" aria-label="Situação dos TCCs orientados">
        <% abas.forEach((aba) => { %>
            <a class="btn <%= situacao === aba.valor ? 'btn-primario' : 'btn-secundario' %>" href="/orientacoes?situacao=<%= aba.valor %>" <%- situacao === aba.valor ? 'aria-current="page"' : '' %>><%= aba.nome %> (<%= aba.total %>)</a>
        <% }) %>
    </nav>
    <p class="resultado-cabecalho">Depois de avaliar, o trabalho sai de Pendentes. Quando o aluno reenviar as correções, ele retorna para análise.</p>
    <div class="lista-admin">
        <% tccs.forEach((tcc) => { %>
            <article class="bloco item-tcc-admin">
                <div>
                    <span class="status status-<%= classeStatus(tcc.status || 'publicado') %>"><%= (tcc.status || 'publicado').replaceAll('_', ' ') %></span>
                    <h2><a href="/tcc/detalhes/<%= idTexto(tcc) %>"><%= tcc.titulo %></a></h2>
                    <p><strong>Aluno:</strong> <%= tcc.autor?.nome || 'Não informado' %> · <%= tcc.curso %> · <%= tcc.turma %></p>
                </div>
                <a class="btn btn-secundario" href="/tcc/detalhes/<%= idTexto(tcc) %>"><%= situacao === 'em_analise' ? 'Analisar trabalho' : 'Ver detalhes' %></a>
            </article>
        <% }) %>
        <% if (!tccs.length) { %>
            <div class="estado-vazio bloco"><h2><%= situacao === 'em_analise' ? 'Nenhum TCC pendente de análise.' : 'Nenhum TCC nesta situação.' %></h2><p>Os trabalhos aparecem aqui conforme a etapa de orientação.</p></div>
        <% } %>
    </div>
</section>

<%- include('../partials/footer') %>
