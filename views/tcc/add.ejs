<%- include('../partials/header') %>

<section class="topo-pagina">
    <div class="container container-form">
        <a class="voltar" href="/tcc/lst">← Voltar para TCCs</a>
        <span class="destaque">Nova publicação</span>
        <h1>Publicar TCC</h1>
        <p>Preencha as informações mínimas para que o trabalho possa ser encontrado e consultado.</p>
    </div>
</section>

<section class="secao container container-form">
    <form class="formulario bloco" action="/tcc/add" method="post" enctype="multipart/form-data">
        <% if (erro) { %><div class="erro-form" role="alert"><%= erro %></div><% } %>
        <%- include('_form', { dados, editando: false }) %>
        <div class="botoes-form">
            <button class="btn btn-primario" type="submit">Publicar TCC</button>
            <a class="btn btn-secundario" href="/tcc/lst">Cancelar</a>
        </div>
    </form>
</section>

<%- include('../partials/footer') %>
