<%- include('../partials/header') %>

<section class="topo-pagina">
    <div class="container topo-pagina-flex">
        <div>
            <span class="destaque">Repositório acadêmico</span>
            <h1>TCCs publicados</h1>
            <p>Consulte trabalhos anteriores por título, tema, resumo ou palavra-chave.</p>
        </div>
        <% if (usuario?.perfil === 'aluno') { %>
            <a class="btn btn-primario" href="/tcc/add">+ Publicar TCC</a>
        <% } %>
    </div>
</section>

<section class="secao container">
    <form class="filtros filtros-completos bloco" action="/tcc/lst" method="get">
        <div class="campo campo-busca">
            <label for="q">Pesquisar</label>
            <input id="q" type="search" name="q" value="<%= filtros.q || '' %>" placeholder="Título, tema, resumo ou palavra-chave">
        </div>
        <div class="campo">
            <label for="curso">Curso</label>
            <select id="curso" name="curso">
                <option value="">Todos</option>
                <% opcoes.cursos.forEach((curso) => { %>
                    <option value="<%= curso %>" <%= filtros.curso === curso ? 'selected' : '' %>><%= curso %></option>
                <% }) %>
            </select>
        </div>
        <div class="campo">
            <label for="ano">Ano</label>
            <select id="ano" name="ano">
                <option value="">Todos</option>
                <% opcoes.anos.forEach((ano) => { %>
                    <option value="<%= ano %>" <%= String(filtros.ano) === String(ano) ? 'selected' : '' %>><%= ano %></option>
                <% }) %>
            </select>
        </div>
        <div class="campo">
            <label for="area">Área</label>
            <select id="area" name="area">
                <option value="">Todas</option>
                <% opcoes.areas.forEach((area) => { %>
                    <option value="<%= area %>" <%= filtros.area === area ? 'selected' : '' %>><%= area %></option>
                <% }) %>
            </select>
        </div>
        <div class="campo">
            <label for="orientador">Orientador</label>
            <select id="orientador" name="orientador">
                <option value="">Todos</option>
                <% opcoes.orientadores.forEach((orientador) => { %>
                    <option value="<%= orientador %>" <%= filtros.orientador === orientador ? 'selected' : '' %>><%= orientador %></option>
                <% }) %>
            </select>
        </div>
        <div class="campo">
            <label for="ordem">Ordenar por</label>
            <select id="ordem" name="ordem">
                <option value="recentes" <%= filtros.ordem === 'recentes' ? 'selected' : '' %>>Mais recentes</option>
                <option value="visualizados" <%= filtros.ordem === 'visualizados' ? 'selected' : '' %>>Mais visualizados</option>
                <option value="downloads" <%= filtros.ordem === 'downloads' ? 'selected' : '' %>>Mais acessados</option>
                <option value="az" <%= filtros.ordem === 'az' ? 'selected' : '' %>>Título de A a Z</option>
            </select>
        </div>
        <div class="filtros-acoes">
            <button class="btn btn-primario" type="submit">Aplicar filtros</button>
            <a class="btn btn-texto" href="/tcc/lst">Limpar</a>
        </div>
    </form>

    <div class="resultado-cabecalho">
        <p><strong><%= tccs.length %></strong> trabalho<%= tccs.length === 1 ? '' : 's' %> encontrado<%= tccs.length === 1 ? '' : 's' %>.</p>
    </div>

    <% if (tccs.length) { %>
        <div class="grade grade-3">
            <% tccs.forEach((tcc) => { %>
                <%- include('../partials/tcc-card', { tcc }) %>
            <% }) %>
        </div>
    <% } else { %>
        <div class="estado-vazio bloco">
            <h2>Nenhum TCC encontrado.</h2>
            <p>Tente pesquisar por outro termo ou remova algum filtro.</p>
            <a class="btn btn-secundario" href="/tcc/lst">Limpar pesquisa</a>
        </div>
    <% } %>
</section>

<%- include('../partials/footer') %>
