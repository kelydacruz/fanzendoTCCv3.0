<%- include('../partials/header') %>

<section class="topo-pagina topo-ideias">
    <div class="container topo-pagina-flex">
        <div>
            <span class="destaque">Biblioteca colaborativa</span>
            <h1>Banco de ideias</h1>
            <p>Encontre problemas e sugestões que podem se transformar em novos projetos.</p>
        </div>
        <a class="btn btn-claro" href="/ideia/add">+ Compartilhar ideia</a>
    </div>
</section>

<section class="secao container">
    <form class="filtros bloco" action="/ideia/lst" method="get">
        <div class="campo campo-busca">
            <label for="q">Pesquisar</label>
            <input id="q" type="search" name="q" value="<%= filtros.q || '' %>" placeholder="Título, tema ou descrição">
        </div>
        <div class="campo">
            <label for="curso">Curso</label>
            <select id="curso" name="curso">
                <option value="">Todos</option>
                <% cursos.forEach((curso) => { %>
                    <option value="<%= curso %>" <%= filtros.curso === curso ? 'selected' : '' %>><%= curso %></option>
                <% }) %>
            </select>
        </div>
        <div class="campo">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">Todos</option>
                <% ['Disponível', 'Em desenvolvimento', 'Concluída'].forEach((status) => { %>
                    <option value="<%= status %>" <%= filtros.status === status ? 'selected' : '' %>><%= status %></option>
                <% }) %>
            </select>
        </div>
        <button class="btn btn-primario" type="submit">Buscar</button>
        <a class="btn btn-texto" href="/ideia/lst">Limpar</a>
    </form>

    <div class="resultado-cabecalho">
        <p><strong><%= ideias.length %></strong> ideia<%= ideias.length === 1 ? '' : 's' %> encontrada<%= ideias.length === 1 ? '' : 's' %>.</p>
    </div>

    <% if (ideias.length) { %>
        <div class="grade grade-3">
            <% ideias.forEach((ideia) => { %>
                <%- include('../partials/ideia-card', { ideia }) %>
            <% }) %>
        </div>
    <% } else { %>
        <div class="estado-vazio bloco">
            <h2>Nenhuma ideia encontrada.</h2>
            <p>Faça uma nova pesquisa ou compartilhe uma sugestão.</p>
            <a class="btn btn-secundario" href="/ideia/add">Compartilhar ideia</a>
        </div>
    <% } %>
</section>

<%- include('../partials/footer') %>
