<div class="form-grid">
    <div class="campo campo-completo">
        <label for="titulo">Título *</label>
        <input id="titulo" name="titulo" value="<%= dados.titulo || '' %>" required maxlength="180">
    </div>

    <div class="campo">
        <label for="tema">Tema *</label>
        <input id="tema" name="tema" value="<%= dados.tema || '' %>" required maxlength="100">
    </div>

    <div class="campo">
        <label for="curso">Curso relacionado *</label>
        <input id="curso" name="curso" value="<%= dados.curso || '' %>" required maxlength="100">
    </div>

    <div class="campo campo-completo">
        <label for="descricao">Descrição *</label>
        <textarea id="descricao" name="descricao" rows="7" required maxlength="2000"><%= dados.descricao || '' %></textarea>
        <small class="ajuda-campo">Explique o problema, o público e uma possível direção para o projeto.</small>
    </div>

    <div class="campo">
        <label for="status">Status</label>
        <select id="status" name="status">
            <% ['Disponível', 'Em desenvolvimento', 'Concluída'].forEach((status) => { %>
                <option value="<%= status %>" <%= dados.status === status ? 'selected' : '' %>><%= status %></option>
            <% }) %>
        </select>
    </div>

    <div class="campo">
        <label for="dificuldade">Nível de dificuldade</label>
        <select id="dificuldade" name="dificuldade">
            <% ['Iniciante', 'Intermediária', 'Avançada'].forEach((nivel) => { %>
                <option value="<%= nivel %>" <%= dados.dificuldade === nivel ? 'selected' : '' %>><%= nivel %></option>
            <% }) %>
        </select>
    </div>
</div>
