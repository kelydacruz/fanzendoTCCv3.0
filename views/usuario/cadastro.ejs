<%- include('../partials/header') %>

<section class="secao secao-formulario">
    <div class="container formulario-layout">
        <div class="formulario-apresentacao">
            <span class="destaque">Faça parte</span>
            <h1>Crie sua conta acadêmica.</h1>
            <p>Seu perfil será identificado automaticamente pelo e-mail institucional. O código é enviado somente para confirmar o cadastro.</p>
        </div>

        <form class="formulario bloco" action="/cadastro" method="post">
            <h2>Criar conta</h2>
            <% if (erro) { %><div class="erro-form" role="alert"><%= erro %></div><% } %>

            <label for="nome">Nome completo *</label>
            <input id="nome" name="nome" value="<%= dados.nome || '' %>" autocomplete="name" required maxlength="100">

            <label for="email">E-mail institucional *</label>
            <input id="email" type="email" name="email" value="<%= dados.email || '' %>" autocomplete="email" required maxlength="150" data-identificar-perfil data-dominio-aluno="<%= dominioAluno %>" data-dominio-professor="<%= dominioProfessor %>">
            <small id="perfil-identificado" class="ajuda-campo">Aluno: @<%= dominioAluno %> · Professor: @<%= dominioProfessor %></small>

            <div data-campo-aluno>
                <label for="curso">Curso <small>(para aluno)</small></label>
                <input id="curso" name="curso" value="<%= dados.curso || '' %>" maxlength="100">
            </div>

            <div data-campo-professor>
                <label for="areaAtuacao">Área de atuação <small>(para professor)</small></label>
                <input id="areaAtuacao" name="areaAtuacao" value="<%= dados.areaAtuacao || '' %>" maxlength="100">
            </div>

            <label for="senha">Senha *</label>
            <input id="senha" type="password" name="senha" autocomplete="new-password" minlength="8" required>
            <small class="ajuda-campo">Use de 8 a 72 caracteres.</small>

            <button class="btn btn-primario btn-largura" type="submit">Criar conta e receber código</button>
            <p class="ajuda-form">Já possui conta? <a href="/entrar">Entre aqui</a>.</p>
        </form>
    </div>
</section>

<%- include('../partials/footer') %>
