<%- include('../partials/header') %>

<section class="secao secao-formulario">
    <div class="container formulario-layout">
        <div class="formulario-apresentacao">
            <span class="destaque">Faça parte</span>
            <h1>Crie sua conta acadêmica.</h1>
            <p>Escolha o perfil correto. Alunos publicam TCCs; alunos e professores compartilham ideias e comentários.</p>
        </div>

        <form class="formulario bloco" action="/cadastro" method="post">
            <h2>Criar conta</h2>
            <% if (erro) { %><div class="erro-form" role="alert"><%= erro %></div><% } %>

            <label for="nome">Nome completo *</label>
            <input id="nome" name="nome" value="<%= dados.nome || '' %>" autocomplete="name" required maxlength="100">

            <label for="email">E-mail *</label>
            <input id="email" type="email" name="email" value="<%= dados.email || '' %>" autocomplete="email" required maxlength="150">

            <label for="perfil">Perfil *</label>
            <select id="perfil" name="perfil" required>
                <option value="">Selecione</option>
                <option value="aluno" <%= dados.perfil === 'aluno' ? 'selected' : '' %>>Aluno</option>
                <option value="professor" <%= dados.perfil === 'professor' ? 'selected' : '' %>>Professor</option>
            </select>

            <label for="curso">Curso <small>(para aluno)</small></label>
            <input id="curso" name="curso" value="<%= dados.curso || '' %>" maxlength="100">

            <label for="areaAtuacao">Área de atuação <small>(para professor)</small></label>
            <input id="areaAtuacao" name="areaAtuacao" value="<%= dados.areaAtuacao || '' %>" maxlength="100">

            <label for="senha">Senha *</label>
            <input id="senha" type="password" name="senha" autocomplete="new-password" minlength="6" required>
            <small class="ajuda-campo">Use de 6 a 72 caracteres.</small>

            <button class="btn btn-primario btn-largura" type="submit">Criar conta</button>
            <p class="ajuda-form">Já possui conta? <a href="/entrar">Entre aqui</a>.</p>
        </form>
    </div>
</section>

<%- include('../partials/footer') %>
