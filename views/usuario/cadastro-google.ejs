<%- include('../partials/header') %>

<section class="secao secao-formulario">
    <div class="container formulario-layout">
        <div class="formulario-apresentacao">
            <span class="destaque">Conta Google confirmada</span>
            <h1>Complete seu perfil acadêmico.</h1>
            <p>Isso acontece somente no primeiro acesso. Depois, você poderá entrar diretamente pelo Google.</p>
        </div>

        <form class="formulario bloco" action="/cadastro/google" method="post">
            <h2>Dados do perfil</h2>
            <% if (erro) { %><div class="erro-form" role="alert"><%= erro %></div><% } %>

            <label for="nome">Nome completo *</label>
            <input id="nome" name="nome" value="<%= dados.nome || '' %>" autocomplete="name" required maxlength="100">

            <label for="email">E-mail confirmado pelo Google</label>
            <input id="email" type="email" value="<%= dados.email || '' %>" disabled>

            <label for="perfil">Perfil *</label>
            <select id="perfil" name="perfil" required>
                <option value="">Selecione</option>
                <option value="aluno" <%= dados.perfil === 'aluno' ? 'selected' : '' %>>Aluno</option>
                <option value="professor" <%= dados.perfil === 'professor' ? 'selected' : '' %>>Professor</option>
            </select>

            <label for="curso">Curso <small>(para aluno)</small></label>
            <input id="curso" name="curso" value="<%= dados.curso || '' %>" maxlength="100">

            <label for="areaAtuacao">Área de atuação <small>(para professor)</small></label>
            <input id="areaAtuacao" name="areaAtuacao" value="<%= dados.areaAtuacao || '' %>" maxlength="100">

            <button class="btn btn-primario btn-largura" type="submit">Salvar e receber o código</button>
        </form>
    </div>
</section>

<%- include('../partials/footer') %>
